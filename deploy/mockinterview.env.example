# Copy to /etc/mockinterview.env on the server (chmod 600, owned by root),
# fill in the values, and NEVER commit the filled-in copy.
# systemd loads it via EnvironmentFile= in mockinterview.service.

# PostgreSQL from 中台. Format: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# (URL-encode special characters in the password, e.g. @ -> %40)
MI_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# Signs the sign-in cookies. A long random string, generated once on the server:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out.
MI_SECRET_KEY=

# The site is served over HTTPS -> sign-in cookies only travel over HTTPS.
MI_COOKIE_SECURE=1

# Where the app reaches itself to render PDFs (must match the --port in the service).
MI_SELF_URL=http://127.0.0.1:8008

# Timestamps (review time, PDF time, archives) in California time, not UTC.
TZ=America/Los_Angeles

# AI comment drafts (Teacher's View). Optional; leave empty to disable the AI button.
OPENAI_API_KEY=
# MI_OPENAI_MODEL=gpt-4o
# Or Claude instead (takes priority when set):
# ANTHROPIC_API_KEY=

# Only used if the app ever starts on an EMPTY database (not the case when the
# demo data is copied in first): the first Admin password. Never leave it at the README default.
MI_INITIAL_ADMIN_PASSWORD=

# Report emails to parents, sent from the school's Microsoft 365 mailbox via Microsoft Graph.
# IT registers an app in Azure (see DEPLOY.md); put its two IDs here (not secrets).
# Then an admin connects the mailbox on Admin -> 发件邮箱 (sign-in with a code).
MI_MS_CLIENT_ID=
MI_MS_TENANT_ID=
# Pre-filled BCC on the send page (hidden copy of every email), comma-separated
MI_MAIL_BCC=
